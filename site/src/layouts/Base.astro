---
import { u } from '../lib/url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

export interface Props {
  title: string; description: string; url?: string;
  noindex?: boolean; jsonld?: object[]; ogType?: string;
  published?: string; modified?: string;
}
const { title, description, url = '/', noindex = false, jsonld = [], ogType = 'website' } = Astro.props;
const canonical = new URL(u(url), Astro.site ?? site.domain).href;
const ORIGIN = (Astro.site ?? new URL(site.domain)).origin;

const org = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness',
  '@id': ORIGIN + u('/') + '#org',
  name: site.brand, description: site.brandFull,
  url: ORIGIN + u('/'),
  address: { '@type': 'PostalAddress', addressRegion: 'Московская область', addressCountry: 'RU', streetAddress: site.addr },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lon },
  areaServed: [{ '@type': 'AdministrativeArea', name: 'Московская область' }, { '@type': 'City', name: 'Москва' }],
  openingHours: 'Mo-Su 00:00-23:59',
};
const all = [org, ...jsonld];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {!noindex && <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.brand} />
  <meta property="og:locale" content="ru_RU" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0C0F14" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={u('/sitemap-index.xml')} />
  {all.map(j => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  <a href="#main" class="sr">Перейти к содержанию</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
