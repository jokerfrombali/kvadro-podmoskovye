---
import { u } from '../lib/url';
import { site, nav } from '../data/site';
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href={u('/')} class="lg" aria-label={`${site.brand} — на главную`}>
      <span class="lg-m">Ø</span><span class="lg-t">{site.brand}</span>
    </a>
    <nav class="nv" aria-label="Основная навигация">
      {nav.map(i => <a href={u(i.u)} class={i.accent ? 'nv-a acc' : 'nv-a'}>{i.t}</a>)}
    </nav>
    <div class="hdr-r">
      <a href="#zayavka" class="btn btn-p btn-sm">Оставить заявку</a>
      <button class="brg" aria-label="Открыть меню" aria-expanded="false" id="brg"><span></span><span></span><span></span></button>
    </div>
  </div>
  <div class="mob" id="mob" hidden>
    <div class="wrap">
      {nav.map(i => <a href={u(i.u)}>{i.t}</a>)}
    </div>
  </div>
</header>
<style>
.hdr{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.93);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.hdr-in{display:flex;align-items:center;gap:16px;height:70px}
.lg{display:flex;align-items:center;gap:10px;font-weight:840;letter-spacing:-.03em;font-size:1.16rem;flex:none}
.lg-m{width:32px;height:32px;border-radius:9px;background:var(--acc);color:#fff;display:grid;place-items:center;font-size:1.1rem;line-height:1}
.nv{display:flex;gap:0;margin-left:auto;flex-wrap:nowrap}
.nv-a{padding:8px 9px;border-radius:8px;font-size:.89rem;font-weight:560;color:var(--tx-2);white-space:nowrap}
.nv-a:hover{background:var(--paper-2);color:var(--tx)}
.nv-a.acc{color:var(--acc-dk);font-weight:680}
.hdr-r{display:flex;align-items:center;gap:12px;flex:none}
.ph{font-weight:700;font-size:.92rem;white-space:nowrap}
.ph:hover{color:var(--acc)}
.brg{display:none;width:40px;height:40px;border:1px solid var(--line);border-radius:9px;background:none;cursor:pointer;flex-direction:column;justify-content:center;align-items:center;gap:4px}
.brg span{width:17px;height:2px;background:var(--tx);border-radius:2px;transition:.2s}
.brg[aria-expanded=true] span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.brg[aria-expanded=true] span:nth-child(2){opacity:0}
.brg[aria-expanded=true] span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
.mob{border-top:1px solid var(--line);background:#fff;padding-block:12px}
.mob .wrap{display:flex;flex-direction:column;gap:2px}
.mob a{padding:12px 4px;border-radius:8px;font-weight:580}
.mob-ph{font-weight:760;color:var(--acc)!important}
@media(max-width:1260px){.nv{display:none}.brg{display:flex}}
@media(max-width:620px){.ph{display:none}.hdr-in{height:62px;gap:12px}}
</style>
<script is:inline>
  const b=document.getElementById('brg'),m=document.getElementById('mob');
  b&&b.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!o));m.hidden=o;});
</script>
